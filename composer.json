{
    "name": "luimedi/remap",
    "description": "A PHP object mapping library using attributes.",
    "keywords": ["mapping", "mapper", "attributes", "php"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Luimedi\\Remap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Luis Medina",
            "email": "6675716+luimedi@users.noreply.github.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "laravel/pint": "^1.27",
        "brainmaestro/composer-git-hooks": "^3.0"
    },
    "scripts": {
        "test": "phpunit",
        "cghooks": "vendor/bin/cghooks",
        "post-install-cmd": [
            "cghooks add --ignore-lock"
        ],
        "post-update-cmd": [
            "cghooks update"
        ]
    },
    "extra": {
        "hooks": {
            "pre-commit": [
                "./vendor/bin/pint --dirty",
                "git add -A"
            ]
        }
    }
}
